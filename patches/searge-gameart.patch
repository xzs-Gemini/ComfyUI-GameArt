@@ -0,0 +1,26 @@
+"""Game-art conditioning using Searge's prompt composition and SDXL encoding."""
+from .stage_clip_conditioning import SeargeStageClipConditioning
+
+
+class SeargeGameArtConditioning:
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {"required": {
+            "clip": ("CLIP",),
+            "prompt": ("STRING", {"multiline": True}),
+            "style": ("STRING", {"multiline": True}),
+            "negative": ("STRING", {"multiline": True}),
+            "width": ("INT", {"default": 1024, "min": 64, "max": 8192, "step": 8}),
+            "height": ("INT", {"default": 1024, "min": 64, "max": 8192, "step": 8}),
+        }}
+
+    RETURN_TYPES = ("CONDITIONING", "CONDITIONING")
+    RETURN_NAMES = ("positive", "negative")
+    FUNCTION = "encode"
+    CATEGORY = "Searge/Game Art"
+
+    def encode(self, clip, prompt, style, negative, width, height):
+        stage = SeargeStageClipConditioning()
+        prompts = stage.create_standard_prompts(prompt, prompt, style, negative, negative, "")
+        positive, _, negative_cond, _ = stage.encode_base(clip, prompts, width, height)
+        return positive, negative_cond
